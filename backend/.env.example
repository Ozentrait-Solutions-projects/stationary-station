# ============================================================
# NexCart Backend — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file to Git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=your_neon_or_postgres_connection_string_here

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# ── Environment ──────────────────────────────────────────────
NODE_ENV=development

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=no-reply@yourdomain.com
RESEND_FROM_NAME=NexCart

# ── Email (SMTP / Gmail fallback) ────────────────────────────
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ── Media Storage ─────────────────────────────────────────────
# Currently using LOCAL disk storage (uploads/ directory).
# AWS S3 integration is modular and can be re-enabled by
# updating backend/middleware/upload.js without other changes.
#
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=your-bucket-name
